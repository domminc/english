{
  "name": "haru-english",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev -c wrangler.local.jsonc",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "content:check": "node scripts/validate-content.mjs",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "postgres": "^4.1.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
