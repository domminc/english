{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haru-english",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // 배포 워크플로가 실제 Hyperdrive ID 로 바꿔 넣는다. 로컬에서는 localConnectionString 을 쓴다.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5433/haru"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "haru-english-media" }],
  "observability": { "enabled": true }
}
