{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haru-english",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // 배포 전에 `wrangler hyperdrive create` 로 만든 ID 로 바꾼다.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5433/haru"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "haru-english-media" }],
  // 발음 음성과 단어 이미지를 처음 요청될 때 만들어 R2 에 저장한다. 없으면 생성 없이 R2 에 있는 파일만 내려준다.
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
