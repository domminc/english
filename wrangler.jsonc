{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haru-english",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 주소: english.richislet.com (richislet.com 이 같은 Cloudflare 계정에 있어야 한다). workers.dev 주소도 함께 유지한다.
  "workers_dev": true,
  "routes": [{ "pattern": "english.richislet.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 모든 요청이 Worker 를 먼저 거친다. http 요청을 https 로 넘기기 위해서다.
    "run_worker_first": true
  },
  // 배포 워크플로가 실제 Hyperdrive ID 로 바꿔 넣는다. 로컬에서는 localConnectionString 을 쓴다.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5433/haru"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "haru-english-media" }],
  "observability": { "enabled": true }
}
